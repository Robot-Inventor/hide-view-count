{
  "name": "hide-impression",
  "version": "2.2.5",
  "description": "Browser extension to hide the number of Twitter impressions",
  "keywords": [
    "addon",
    "extension",
    "twitter"
  ],
  "homepage": "https://github.com/Robot-Inventor/hide-impression#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/hide-impression/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/hide-impression.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "cross-env NODE_ENV=production rspack build",
    "watch": "cross-env NODE_ENV=development rspack build --watch",
    "ci:build": "cross-env NODE_ENV=production rspack build --env updateUserScripts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ./src ./rspack.config.ts ./script",
    "package": "node ./script/package.ts",
    "version": "npm run build && git add ."
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "twi-ext": "^1.0.0",
    "web-ext": "^10.0.0"
  },
  "devDependencies": {
    "@robot-inventor/oxlint-config": "^1.0.0",
    "@robot-inventor/tsconfig-base": "^7.0.0",
    "@rspack/cli": "^2.0.2",
    "@rspack/core": "^2.0.1",
    "@types/node": "^26.1.2",
    "cross-env": "^10.0.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.0"
  }
}
